{
  "name": "palmsight",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "pnpm -r --parallel --if-present run dev",
    "build": "pnpm -r --if-present run build",
    "lint": "pnpm -r --if-present run lint",
    "test": "pnpm -r --if-present run test",
    "typecheck": "pnpm -r --if-present run typecheck",
    "dev:backend": "pnpm --filter backend dev",
    "dev:frontend": "pnpm --filter frontend dev",
    "dev:mobile": "pnpm --filter mobile start",
    "android": "pnpm --filter mobile android",
    "ios": "pnpm --filter mobile ios",
    "test:backend": "pnpm --filter backend test",
    "test:frontend": "pnpm --filter frontend test",
    "typecheck:backend": "pnpm --filter backend typecheck",
    "typecheck:frontend": "pnpm --filter frontend typecheck",
    "stitch:sync": "node scripts/sync-stitch-screens.mjs",
    "push": "bash scripts/modular-push.sh",
    "prepare": "pnpm --filter @palmsight/shared build"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "esbuild"
    ],
    "overrides": {
      "metro": "0.87.1",
      "metro-babel-transformer": "0.87.1",
      "metro-cache": "0.87.1",
      "metro-cache-key": "0.87.1",
      "metro-config": "0.87.1",
      "metro-core": "0.87.1",
      "metro-file-map": "0.87.1",
      "metro-minify-terser": "0.87.1",
      "metro-resolver": "0.87.1",
      "metro-runtime": "0.87.1",
      "metro-source-map": "0.87.1",
      "metro-symbolicate": "0.87.1",
      "metro-transform-plugins": "0.87.1",
      "metro-transform-worker": "0.87.1"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1"
  }
}
