# Google OAuth Client IDs (Google Cloud Console > Credentials)
# Web Client ID (dùng cho Web hoặc kiểm thử)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=1001438141254-c7mc6t2sreqj0ho8kdkfanvui5sn0b0h.apps.googleusercontent.com

# Android Client ID: Tạo trên Google Cloud Console với Type = Android
# Package Name: com.palmsight.app
# SHA-1: Lấy từ keystore của bạn hoặc debug keystore của Expo
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# iOS Client ID: Tạo trên Google Cloud Console với Type = iOS
# Bundle ID: com.palmsight.app
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Backend API Base URL (Dùng IP máy tính nếu chạy máy ảo / điện thoại thật qua Expo Go)
EXPO_PUBLIC_API_URL=http://localhost:3000
